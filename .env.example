# Copy to .env (or export these in your shell / hosting panel).
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for HTTPS deployments, e.g. https://erp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional: override DB location (defaults to dakshyam_erp/db.sqlite3)
DJANGO_DB_PATH=
DATABASE_URL=
# --- Email (REQUIRED in production: students must receive their verification link) ---
# Development default prints emails in the console. For real mail use SMTP:
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST='://gmail.com'
EMAIL_PORT=587
EMAIL_HOST_USER='dakshyaminnovations@gmail.com'
EMAIL_HOST_PASSWORD='wecl uegu bqaz cmnk'
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Dakshyam Innovations <no-reply@dakshyaminnovations.in>

# --- Behind a reverse proxy / uploads ---
